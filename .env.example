# Gulf Disruption Radar - Environment Variables
# Copy this file to .env and fill in your actual values

RAPIDAPI_KEY=your_aerodatabox_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
DATABASE_URL=postgresql://user:password@host:port/db  # Optional; SQLite used if not set
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=your_email@gmail.com
ADMIN_EMAIL=admin_email@gmail.com
APP_BASE_URL=https://your-domain.com
DEBUG=false
MY_TELEGRAM_ID=your_telegram_chat_id
Radar_Pro_Monthly=https://checkout.dodopayments.com/buy/your_monthly_product_id?quantity=1
Radar_Pro_Annual=https://checkout.dodopayments.com/buy/your_annual_product_id?quantity=1
DODO_WEBHOOK_SECRET=your_dodo_webhook_secret_here
